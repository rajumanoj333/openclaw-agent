# ─── Sarvam AI ────────────────────────────────
SARVAM_API_KEY=xxxxxxxxxxxxxxxxxxxx
SARVAM_BASE_URL=https://api.sarvam.ai

# ─── Postgres ─────────────────────────────────
POSTGRES_USER=agent
POSTGRES_PASSWORD=changeme_local_dev
POSTGRES_DB=agentdb
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────
